; GX color channel 0 (color and alpha) lit as SMG's light director loads it: two diffuse lights, a light at
; the camera that only lights alpha, and the scene's ambient; plus three texgens for the combiner's units.
.fvec projection[4], modelView[4]
.fvec materialColor, lightAmbient
.fvec light0Pos, light0Color, light1Pos, light1Color, light2Alpha
.fvec colorSelect, alphaSelect, colorLights, alphaLights
.fvec texgen0[3], texgen1[3], texgen2[3]
.constf constants(0.0, 1.0, 0.5, 0.00392156862)
.constf scales(0.00787401574, 0.0, 0.0, 0.0)
.out outpos position
.out outcolor color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.alias inpos v0
.alias inuv v1
.alias inclr v2
.alias innrm v3

.proc main
    mov r0.xyz, inpos
    mov r0.w, constants.y
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    mov r1.w, constants.y
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    ; View-space unit normal
    mul r2.xyz, scales.xxx, innrm.xyz
    mov r2.w, constants.x
    dp4 r3.x, modelView[0], r2
    dp4 r3.y, modelView[1], r2
    dp4 r3.z, modelView[2], r2
    dp3 r4.x, r3.xyz, r3.xyz
    rsq r4.x, r4.x
    mul r3.xyz, r3.xyz, r4.xxx

    ; Material and ambient colors come from their registers or the vertex, as the channel says
    mul r5, constants.wwww, inclr
    add r6, -materialColor, r5
    mul r6, colorSelect.xxxw, r6
    add r6, materialColor, r6
    mov r7.xyz, colorSelect.yyy
    mov r7.w, alphaSelect.x
    add r8, -lightAmbient, r5
    mul r8, r7, r8
    add r8, lightAmbient, r8

    ; N.L toward each light's view-space position; light 2 sits at the camera
    add r9.xyz, light0Pos.xyz, -r1.xyz
    dp3 r10.x, r9.xyz, r9.xyz
    rsq r10.x, r10.x
    mul r9.xyz, r9.xyz, r10.xxx
    dp3 r11.x, r3.xyz, r9.xyz
    add r9.xyz, light1Pos.xyz, -r1.xyz
    dp3 r10.x, r9.xyz, r9.xyz
    rsq r10.x, r10.x
    mul r9.xyz, r9.xyz, r10.xxx
    dp3 r11.y, r3.xyz, r9.xyz
    mov r9.xyz, -r1.xyz
    dp3 r10.x, r9.xyz, r9.xyz
    rsq r10.x, r10.x
    mul r9.xyz, r9.xyz, r10.xxx
    dp3 r11.z, r3.xyz, r9.xyz
    mov r11.w, constants.x
    max r12, constants.xxxx, r11

    ; Color: each masked light's color times its signed or clamped N.L, over the ambient
    add r13, r12, -r11
    mad r13, r13, colorLights.wwww, r11
    mul r13, colorLights, r13
    mad r14.xyz, r13.xxx, light0Color.xyz, r8.xyz
    mad r14.xyz, r13.yyy, light1Color.xyz, r14.xyz

    ; Alpha: the same with each light's alpha; only the camera light carries one
    add r13, r12, -r11
    mad r13, r13, alphaLights.wwww, r11
    mul r13, alphaLights, r13
    mad r14.w, r13.x, light0Color.w, r8.w
    mad r14.w, r13.y, light1Color.w, r14.w
    mad r14.w, r13.z, light2Alpha.x, r14.w

    ; Saturate, and leave an unlit channel at the material color
    max r14, constants.xxxx, r14
    min r14, constants.yyyy, r14
    add r14, -constants.yyyy, r14
    mov r15.xyz, colorSelect.zzz
    mov r15.w, alphaSelect.y
    mul r14, r15, r14
    add r14, constants.yyyy, r14
    mul outcolor, r6, r14

    ; Sphere-map coordinates stand in for GX's normal-driven environment texgens
    mul r10.xy, constants.zz, r3.xy
    add r10.xy, constants.zz, r10.xy

    mul r11.xy, texgen0[2].xx, inuv.xy
    mad r11.xy, inuv.zw, texgen0[2].yy, r11.xy
    mad r11.xy, r10.xy, texgen0[2].zz, r11.xy
    mov r11.z, constants.y
    dp3 outtc0.x, texgen0[0].xyz, r11.xyz
    dp3 outtc0.y, texgen0[1].xyz, r11.xyz

    mul r11.xy, texgen1[2].xx, inuv.xy
    mad r11.xy, inuv.zw, texgen1[2].yy, r11.xy
    mad r11.xy, r10.xy, texgen1[2].zz, r11.xy
    dp3 outtc1.x, texgen1[0].xyz, r11.xyz
    dp3 outtc1.y, texgen1[1].xyz, r11.xyz

    mul r11.xy, texgen2[2].xx, inuv.xy
    mad r11.xy, inuv.zw, texgen2[2].yy, r11.xy
    mad r11.xy, r10.xy, texgen2[2].zz, r11.xy
    dp3 outtc2.x, texgen2[0].xyz, r11.xyz
    dp3 outtc2.y, texgen2[1].xyz, r11.xyz
    end
.end
