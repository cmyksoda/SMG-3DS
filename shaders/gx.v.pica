; The GX renderer's two kinds of vertices. With `transform` off they arrive transformed on the CPU
; (source/core/GxDraw.cpp's GxVertexPipeline): position in clip space and each combiner unit's coordinates.
; With it on they are a cached mesh's (GxMeshVertex): a model-space position transformed by its matrix slot's
; four rows, and each texgen's input vector through its three rows, divided by q where the texgen projects; the
; colour's parts each from the vertex or the material register (rgbreg, alphareg), lit like GxLighting::apply.
; Lit meshes take ten rows a slot (clip, modelview, normal) and up to four light entries of six rows (GxMeshUniforms):
; the SDK puts directional lights at 1e18, past what the PICA's 24-bit floats square, so positions come prescaled; an
; entry's settings are numbers mixed in, so colour and alpha can be lit differently in one loop.
.constf scale(0.00392156862, 1.0, 0.0, 0.0)
.fvec clip[40]
.fvec texrow[9]
.fvec material
.fvec ambient
.fvec light[24]
.ivec lightloop
.bool transform
.bool lit
.bool rgblit
.bool alphalit
.bool anylight
.bool rgbreg
.bool alphareg
.bool project0
.bool project1
.bool project2
.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.alias inpos v0
.alias inclr v1
.alias intc0 v2
.alias intc1 v3
.alias intc2 v4
.alias inslot v5
.alias innrm v6

.proc main
    mul r2, scale.xxxx, inclr
    ifu rgbreg
        mov r2.xyz, material.xyz
    .end
    ifu alphareg
        mov r2.w, material.w
    .end
    ifu transform
        mova a0.x, inslot.x
        dp4 outpos.x, clip[a0.x], inpos
        dp4 outpos.y, clip[a0.x+1], inpos
        dp4 outpos.z, clip[a0.x+2], inpos
        dp4 outpos.w, clip[a0.x+3], inpos
        dp4 r0.x, texrow[0], intc0
        dp4 r0.y, texrow[1], intc0
        ifu project0
            dp4 r1.x, texrow[2], intc0
            rcp r1.x, r1.x
            mul r0.xy, r0.xy, r1.xx
        .end
        mov outtc0, r0
        dp4 r0.x, texrow[3], intc1
        dp4 r0.y, texrow[4], intc1
        ifu project1
            dp4 r1.x, texrow[5], intc1
            rcp r1.x, r1.x
            mul r0.xy, r0.xy, r1.xx
        .end
        mov outtc1, r0
        dp4 r0.x, texrow[6], intc2
        dp4 r0.y, texrow[7], intc2
        ifu project2
            dp4 r1.x, texrow[8], intc2
            rcp r1.x, r1.x
            mul r0.xy, r0.xy, r1.xx
        .end
        mov outtc2, r0
        ifu lit
            call light_vertex
        .end
    .else
        mov outpos, inpos
        mov outtc0, intc0
        mov outtc1, intc1
        mov outtc2, intc2
    .end
    mov outclr, r2
    end
.end

; r3 the view-space position, r4 the normal, r5 the sum of ambient and each light, then r2 scaled by it; r15 holds
; zero and one (an instruction's second source can't be a uniform).
.proc light_vertex
    mov r15.xy, scale.zy
    dp4 r3.x, clip[a0.x+4], inpos
    dp4 r3.y, clip[a0.x+5], inpos
    dp4 r3.z, clip[a0.x+6], inpos
    dp3 r4.x, clip[a0.x+7], innrm
    dp3 r4.y, clip[a0.x+8], innrm
    dp3 r4.z, clip[a0.x+9], innrm
    dp3 r4.w, r4, r4
    rsq r4.w, r4.w
    mul r4.xyz, r4.xyz, r4.www
    mov r5, ambient
    ifu anylight
        for lightloop
            mov r10, light[aL+4]
            mov r11, light[aL+1]
            mov r12, light[aL+2]
            mov r9, light[aL+3]
            mov r14, light[aL+5]
            mad r6.xyz, r3.xyz, r10.xxx, r11.xyz
            dp3 r7.x, r6, r6
            rsq r7.y, r7.x
            mul r6.xyz, r6.xyz, r7.yyy
            ; spot: the angle to its direction and the distance; specular: the half-angle's, both
            dp3 r7.w, r6, r12
            max r7.w, r7.w, r15.x
            mul r7.z, r7.x, r7.y
            mul r7.z, r7.z, r10.y
            dp3 r8.y, r6, r4
            dp3 r13.z, r12, r4
            max r13.z, r13.z, r15.x
            sge r13.w, r8.y, r15.x
            mul r13.z, r13.z, r13.w
            add r13.x, r7.w, -r13.z
            mad r7.w, r13.x, r14.x, r13.z
            add r13.x, r7.z, -r13.z
            mad r7.z, r13.x, r14.x, r13.z
            mad r13.x, r7.w, r9.x, r12.w
            mad r13.x, r13.x, r7.w, r11.w
            max r13.x, r13.x, r15.x
            mad r13.y, r7.z, r9.w, r9.z
            mad r13.y, r13.y, r7.z, r9.y
            rcp r13.y, r13.y
            mul r8.x, r13.x, r13.y
            ; turned by the normal: 1 + diffuse (max(cos, floor) - 1)
            max r8.y, r8.y, r14.z
            add r8.y, r8.y, -r15.y
            mad r8.y, r8.y, r14.y, r15.y
            mul r8.x, r8.x, r8.y
            mov r14, light[aL]
            mad r5, r14, r8.xxxx, r5
        .end
    .end
    max r5, r5, r15.xxxx
    min r5, r5, r15.yyyy
    ifu rgblit
        mul r2.xyz, r2.xyz, r5.xyz
    .end
    ifu alphalit
        mul r2.w, r2.w, r5.w
    .end
.end
